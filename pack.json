      "license": "MIT",
      "source_revision": "8b2118560f9e4b3421c0d923b4e1b8d681aa75f1"
    },
    {
      "contract": "tap.page-resource/v1",
      "id": "chatgpt.files.feature",
      "version": "0.1.2",
      "kind": "browser-classic-script",
      "file": "feature.js",
      "sha256": "70ca5d7250b63d9fb6ad08af4674f8bb37e6f7051dacc98b36ad0a1e58dd4211",
      "license": "MIT",
      "source_revision": "sha256:70ca5d7250b63d9fb6ad08af4674f8bb37e6f7051dacc98b36ad0a1e58dd4211"
    }
  ],
  "features": [
    {
      "id": "reveal-markdown",
