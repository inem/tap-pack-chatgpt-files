      "interface": "python-jsonl-v1"
    }
  },
  "config": {},
  "access": {
    "origins": [
      "https://chatgpt.com",
      "https://www.chatgpt.com",
      "https://chat.openai.com"
    ],
    "capabilities": [
      "page.inject",
      "bridge.handle"
    ]
  }
